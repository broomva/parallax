node_modules/
*.db
*.db-*
.env
dist/
design/parallax-console.html
out/

# The Next build output. It is produced in CI from web/ and never committed:
# a checked-in export is a second source of truth that goes stale silently.
web/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo

# Scroll-cinema generation intermediates. `web/cinema/storyboard.json` is the
# durable artifact and `web/public/cinema/` is what ships; raw/, video/ and the
# .jpg stills are ~40MB of regenerable middle. Note `dist/` and `out/` above are
# BARE patterns, so anything named that anywhere in this tree vanishes silently.
web/cinema/assets/
out/veo-raw/

# unslop scan output: regenerable from the scripts, not source.
.unslop/
