{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!design",
      "!node_modules",
      "!.unslop",
      "!web/node_modules",
      "!web/.next",
      "!web/out",
      "!web/next-env.d.ts",
      "!web/public/proof",
      "!web/tsconfig.tsbuildinfo"
    ]
  }
}
